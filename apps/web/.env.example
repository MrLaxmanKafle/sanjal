# Canonical origin. Metadata, sitemap and robots.txt are built from this.
# Set it once the domain is connected.
NEXT_PUBLIC_SITE_URL=https://sanjal.com

# Where waitlist signups are POSTed as JSON: { email, city, source, at }.
# Any endpoint that accepts a JSON POST works — a spreadsheet automation, an
# email service, a CRM. Until this is set the form returns an honest error and
# points people at email rather than silently dropping signups.
WAITLIST_WEBHOOK_URL=
